        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Uzun Dönem Stajyer Yazılım",
        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Yapay Zeka Stajyer",
        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Data Science Intern",
        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Graduate Program Software",
        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Yeni Mezun Yazılım",
        "location": "Türkiye",
        "pipeline": "internship"
      },
      {
        "query": "Backend Intern",
        "location": "Remote",
        "remote": "remote",
