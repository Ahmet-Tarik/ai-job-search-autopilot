    "freehire": [
      {
        "args": [
          "--seniority",
          "junior",
          "--country",
          "TR"
        ]
      },
      {
        "args": [
          "--seniority",
          "junior",
          "--category",
          "backend,fullstack",
          "--remote",
          "remote",
          "--region",
          "global"
        ]
      },
      {
        "args": [
          "-q",
          "intern",
          "--category",
          "backend,fullstack",
          "--remote",
          "remote",
          "--region",
          "global,eu,mena"
        ]
      },
      {
        "args": [
          "--seniority",
          "junior",
          "--category",
          "ml_ai,qa",
          "--country",
          "TR"
        ]
      }
    ],
    "ats": {
      "_comment": "Official employer job boards (public Lever/Greenhouse APIs). Add slugs for companies you follow.",
      "max_age_days": 45,
      "location_must_match": "t[üu]rk|istanbul|İstanbul|ankara|izmir|remote|uzaktan|emea|europe|worldwide|anywhere",
      "lever": [
        "insiderone",
        "trendyol",
        "picus",
        "peakgames",
        "dreamgames",
        "getmidas",
        "iyzico",
        "appnation",
        "commencis"
      ],
      "greenhouse": [
        "peak",
        "udemy",
        "gram"
      ],
      "workable": []
    }
  },
