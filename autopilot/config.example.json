{
  "_comment": "Example configuration. Copy to config.json (git-ignored) and edit. See docs/configuration.md and AUTHORIZATION.md.",
  "timezone": "Europe/Istanbul",
  "drafting": {
    "min_rank_score": 70,
    "daily_draft_cap": 2,
    "rank_batch_limit": 10,
    "require_gates_pass": true,
    "istanbul_policy": "list_only_unless_remote",
    "do_not_draft": {
      "example-co_backend-intern": "Example: a job the candidate declined (reason kept for the record)"
    }
  },
  "briefings": {
    "morning": "09:00",
    "evening": "22:00",
    "consider_score": 55
  },
  "scrape": {
    "jobage_days": 3,
    "limit_per_query": 20,
    "pause_seconds_between_calls": 2,
    "linkedin": [
      {
        "query": "Junior Software Engineer",
        "location": "Ankara, Türkiye"
      },
      {
