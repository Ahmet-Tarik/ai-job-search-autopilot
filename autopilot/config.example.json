    "telegram_env_file": "~/.config/job-search/telegram.env",
    "mac_notification_fallback": true
  },
  "email": {
    "_comment": "Work/freelance contacts monitored besides job applications (added 2026-11-09). 'match' terms are checked against sender name/address, subject and snippet.",
    "work_contacts": [
      {
        "name": "Example Freelance Platform",
        "match": [
          "example-platform.com",
          "example platform"
        ]
      }
    ],
    "payment_senders": [
      "payoneer",
      "wise.com",
      "paypal",
      "deel",
      "remote.com",
      "stripe",
      "papara",
      "tipalti"
    ]
  },
  "shortlist": {
    "_comment": "Hard eligibility gates are separate from soft fit. Thresholds agreed 2026-11-09: internships 50, junior 60.",
    "threshold_internship": 50,
    "threshold_junior": 60,
    "max_items": 15,
    "internship_regex": "intern|staj|stajyer|trainee|graduate program|new grad|yeni mezun|summer 20\\d\\d|off-cycle|working student|apprentice|long-term intern|uzun dönem",
    "junior_regex": "junior|\\bjr\\.?\\b|entry[- ]level|associate|0-2|new graduate|software (engineer|developer)|developer|engineer|yazılım (mühendisi|geliştirici)"
  },
  "local_llm": {
    "_comment": "First-pass screening only (facts + quote-verified hard rejections). Claude stays the planner, ranker and final reviewer. Model chosen by reports/model_compare_20261110 (47 unseen postings).",
    "enabled": true,
    "model": "qwen3.5:9b",
    "host": "http://localhost:11434",
    "num_ctx": 8192,
    "timeout": 240,
    "keep_alive": "2m",
    "max_input_chars": 12000,
    "num_predict": 2000,
    "min_mem_free_pct": 8,
    "audit_every_nth_rejection": 3,
    "activated": "Example: record when and why the model was activated (benchmark report, approval).",
    "fallback_model_installed": "qwen3.5:35b",
    "fallback_note": "Optional: a second installed model to revert to. Never load two models at once."
  },
  "excluded_companies": {
    "example excluded co": "Example: a company the candidate never wants to see again (history kept)."
  },
  "candidate": {
    "_comment": "Everything the code needs to know about the candidate. The real values live only in your private config.json.",
    "llm_profile": "Candidate (fictional example): lives in Istanbul, Turkey, and is authorized to work in Turkey. Recent BSc Computer Engineering graduate. Languages: Turkish (native), English (C1). Needs visa sponsorship for onsite work abroad. Verified skills (junior level): Java, Spring Boot, PostgreSQL, REST APIs, JUnit, Docker, Git, TypeScript, React. Experience: one six-month backend internship. Wants graduate programs and 0-2 year backend or full-stack roles.",
    "home_region_regex": "turkey|t[üu]rkiye|istanbul|i̇stanbul|ankara|izmir|kocaeli|bursa|antalya|gebze|\\bemea\\b|worldwide|anywhere",
    "undeclared_languages_regex": "german|deutsch|almanca|french|fran[cç]ais|frans[ıi]zca|spanish|espa[nñ]ol|[ıi]spanyolca|dutch|nederlands|polish|polski|italian|italiano|portuguese|romanian|rom[aâ]n[aă]|russian|arabic|arap[cç]a|japanese|chinese|mandarin|korean|swedish|danish|norwegian|finnish|czech|hungarian|greek|hebrew|azerbaijani|ukrainian|bulgarian|croatian|serbian|slovak",
    "location": {
      "_comment": "Shortlist ordering (lower = better). Regexes are matched against location + title.",
      "home_city_regex": "istanbul|İstanbul",
      "home_country_regex": "t[üu]rk(iye|ey)|istanbul|İstanbul|ankara|izmir|kocaeli|bursa|antalya|\\btr\\b",
      "home_country_name": "Turkey",
      "relocation_city_regex": "ankara|izmir",
      "last_resort_regex": "(?!x)x",
      "last_resort_note": "work right not verified (last resort)"
    }
  },
  "backup": {
    "_comment": "Google Drive for desktop sync root and destination folder (see drive_backup.py).",
    "drive_account_root": "~/Library/CloudStorage/GoogleDrive-you@example.com",
    "destination": "Job Search Autopilot/Backups"
  }
